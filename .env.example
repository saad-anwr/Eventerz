# ---------------------------------------------------------------------------
# Eventerz - environment variables (copy to `.env.local` and fill in)
# All NEXT_PUBLIC_* vars are exposed to the browser. Keep secrets server-only.
# ---------------------------------------------------------------------------

# Site
NEXT_PUBLIC_SITE_URL="https://eventerz.xyz"

# ---------------------------------------------------------------------------
# Solana / RPC (Helius)
#
# The RPC URL carries the API key in its query string, and NEXT_PUBLIC_ means it
# is inlined into the browser bundle - so this key is readable by anyone who
# opens devtools. That is inherent to calling an RPC from the client, not a
# misconfiguration, but it makes the key a rate-limit control rather than a
# secret: cap it and restrict it by domain in the Helius dashboard, and rotate
# it on the same schedule you would any other public identifier.
# ---------------------------------------------------------------------------
NEXT_PUBLIC_SOLANA_NETWORK="mainnet-beta"
NEXT_PUBLIC_HELIUS_RPC_URL="https://mainnet.helius-rpc.com/?api-key=YOUR_KEY"

# ---------------------------------------------------------------------------
# Anchor program
#
# Leave BLANK until the program is deployed. Every on-chain action checks this
# and skips cleanly when unset - RSVPs, tickets and payments are real without it.
# Set it and the app starts claiming seats on-chain.
#
# Deploy it from `../Eventerz Program` (see that README), then paste the address
# `anchor keys sync` printed. Inlined at build time, so changing it needs a
# redeploy.
# ---------------------------------------------------------------------------
NEXT_PUBLIC_EVENTERZ_PROGRAM_ID=""

# Metaplex / cNFT
NEXT_PUBLIC_MERKLE_TREE_ADDRESS=""

# ---------------------------------------------------------------------------
# Supabase - powers REAL authentication (Google + passwordless email).
#
# Fill these two in and sign-in stops being simulated. Leave them blank and the
# site keeps working against the local demo store.
#
# Full walkthrough: docs/AUTH_SETUP.md
# Dashboard -> Project Settings -> API
# ---------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=""
NEXT_PUBLIC_SUPABASE_ANON_KEY=""

# Server-only. Bypasses Row Level Security - never prefix this NEXT_PUBLIC_.
#
# Also needed by the Edge Functions, where it is set as a secret rather than read
# from here:
#   supabase secrets set SUPABASE_SERVICE_ROLE_KEY=...
#   supabase secrets set ALLOWED_ORIGINS=https://www.eventerz.xyz,https://eventerz.xyz
#   supabase secrets set HELIUS_RPC_URL=...        # optional, for verify-payment
SUPABASE_SERVICE_ROLE_KEY=""

# ---------------------------------------------------------------------------
# Google Maps  (optional)
#
# Optional on purpose. With a key, event pages get the Maps Embed API and the
# create form gets Google Places autocomplete. Without one they fall back to an
# OpenStreetMap embed plus Nominatim search, and every "Open in Maps" link works
# either way - those use the keyless `?api=1` URL scheme.
#
# Restrict the key by HTTP referrer in Google Cloud Console; it is exposed to the
# browser by design, exactly like the Supabase anon key.
#
# APIs to enable: Maps Embed API, Places API (New), Maps Static API.
# ---------------------------------------------------------------------------
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=""

# ---------------------------------------------------------------------------
# Database (local test suite only)
#
# `npm run test:db` runs supabase/tests/*.sql against this. Unset, it uses the
# fixed loopback URL that `supabase start` prints for every developer
# (postgresql://postgres:postgres@127.0.0.1:54322/postgres) - a published
# default on 127.0.0.1, not a credential.
#
# Never point this at a hosted database from a developer machine. Production
# migrations go through `supabase db push`, which uses your CLI login.
# ---------------------------------------------------------------------------
DATABASE_URL=""

# ---------------------------------------------------------------------------
# Not wired up yet - listed so the names are settled before anything reads them.
# Nothing in the app looks these up today.
# ---------------------------------------------------------------------------

# Analytics
NEXT_PUBLIC_ANALYTICS_ID=""

# Newsletter (e.g. Resend / ConvertKit). Server-only - no NEXT_PUBLIC_ prefix.
NEWSLETTER_API_KEY=""

# ---------------------------------------------------------------------------
# Auth providers
#
# NOTE: with Supabase Auth these do NOT belong here. The Google client ID and
# secret are pasted into the Supabase dashboard (Authentication -> Providers ->
# Google), so the secret never reaches this repo or the client bundle.
#
# Kept only as a reminder of what to create - see docs/AUTH_SETUP.md step 3.
# ---------------------------------------------------------------------------
# Google OAuth   -> https://console.cloud.google.com  -> paste into Supabase
# Apple OAuth    -> https://developer.apple.com       -> paste into Supabase
APPLE_CLIENT_SECRET=""
# Email magic links (e.g. Resend)
EMAIL_SERVER=""
EMAIL_FROM="eventerz.web@gmail.com"
