# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
Thumbs.db

# Credentials and signing material. Belt and braces with
# `scripts/check-secrets.mjs`, which checks *content* rather than paths - this
# list only covers the files somebody thought of in advance.
*.pem
*.jks
*.keystore
*.p12
*.p8
*.mobileprovision
id_rsa
id_ed25519

# Compiled apps. Never commit these: `NEXT_PUBLIC_*` values are inlined into
# the bundle at build time, so a committed binary hands every build-time value
# to anyone who can `grep` it.
*.apk
*.aab
*.ipa

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files
.env
.env*.local

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

.vercel

# Every env file stays local — except the placeholder template, which is the
# only record of *which* variables a fresh clone has to set. The bare `.env*`
# above it would swallow that too, and the file survives today only because it
# was committed before the rule existed; re-adding it would silently fail.
.env*
!.env.example

# Supabase CLI scratch state. `linked-project.json` was committed by an
# automated build commit; it is regenerated by `supabase link` and pins this
# machine's linked project ref, which is per-developer, not per-repo.
supabase/.temp/
